      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "GET",
        "url": "=https://api.vapi.ai/call/{{ $('Vapi events').first().json.body.message.call.id }}",
        "options": {},
