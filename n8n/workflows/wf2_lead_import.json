  "nodes": [
    {
      "id": "286c1847-9f6b-49c0-8873-19aca1d13b89",
      "name": "Mapping request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-map",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "2d0cdc2a-7901-40bb-919c-0b514671d194",
      "position": [
        0,
        0
      ]
    },
    {
      "id": "e25487fe-d3de-447d-9c09-f4b5e8151ab5",
      "name": "Build mapping prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const { headers = [], sample = [] } = $input.first().json.body || {};\nconst system = 'You map spreadsheet columns to a CRM lead schema. Fields: name, phone, email, location, budget, notes. ' +\n  'Use \"extra\" for anything else. Each field may be used at most once, except \"extra\". Reply with JSON only: {\"mapping\": {\"<column>\": \"<field>\"}}.';\nconst user = 'Columns: ' + JSON.stringify(headers) + '\\nSample rows: ' + JSON.stringify(sample.slice(0, 5));\nreturn [{ json: { headers, messages: [{ role: 'system', content: system }, { role: 'user', content: user }] } }];"
      },
      "position": [
        260,
        0
      ]
    },
    {
      "id": "ae695d42-eacb-42b3-bc60-0a0fa081734a",
      "name": "Ask Groq for mapping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROQ_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'openai/gpt-oss-120b', reasoning_effort: 'low', temperature: 0, response_format: { type: 'json_object' }, messages: $json.messages }) }}"
      },
      "onError": "continueRegularOutput",
      "position": [
        520,
        0
      ]
    },
    {
      "id": "fdd74248-e7cd-49b8-8a55-000719cf264f",
      "name": "Read mapping",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const allowed = ['name', 'phone', 'email', 'location', 'budget', 'notes', 'extra'];\nconst headers = $('Build mapping prompt').first().json.headers;\nlet mapping = null;\ntry {\n  const parsed = JSON.parse($input.first().json.choices[0].message.content).mapping || {};\n  mapping = {};\n  for (const h of headers) mapping[h] = allowed.includes(parsed[h]) ? parsed[h] : 'extra';\n} catch (e) { mapping = null; }          // browser falls back to keyword matching\nreturn [{ json: { mapping } }];"
      },
      "position": [
        780,
        0
      ]
    },
    {
      "id": "e1c50b44-e0ef-4bdf-8414-50f80fbb3e8f",
      "name": "Return mapping",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ mapping: $json.mapping }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "position": [
        1040,
        0
      ]
    },
    {
      "id": "edee0570-13c1-4114-b97d-656699e00aa5",
      "name": "Import request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-import",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "webhookId": "eda39611-c211-4665-8bec-d32d765febd9",
