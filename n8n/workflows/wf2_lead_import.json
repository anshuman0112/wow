        0,
        180
      ]
    },
    {
      "id": "512c474b-af5f-4eb1-bab5-a30d4be7f60f",
      "name": "Clean leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// Server-side safety net: normalise phones, drop invalid rows, dedupe, whitelist fields.\nconst rows = ($input.first().json.body || {}).leads || [];\nconst norm = raw => {\n  let p = String(raw || '').replace(/[^\\d+]/g, '');\n  if (p.startsWith('00')) p = '+' + p.slice(2);\n  if (!p.startsWith('+')) {\n    if (p.length === 10) p = '+91' + p;\n    else if (p.length === 12 && p.startsWith('91')) p = '+' + p;\n    else if (p.length === 11 && p.startsWith('0')) p = '+91' + p.slice(1);\n  }\n  return /^\\+\\d{10,15}$/.test(p) ? p : null;\n};\nconst seen = new Set();\nconst leads = [];\nfor (const r of rows) {\n  const phone = norm(r.phone);\n  if (!phone || seen.has(phone)) continue;\n  seen.add(phone);\n  leads.push({\n    phone,\n    name: r.name ? String(r.name).slice(0, 120) : null,\n    email: r.email || null, location: r.location || null, budget: r.budget || null,\n    notes: r.notes || null, source: r.source || 'upload',\n    extra: r.extra && typeof r.extra === 'object' ? r.extra : {},\n    campaign_id: 'divyasree-wow',\n  });\n}\nreturn [{ json: { leads, received: rows.length } }];"
      },
      "position": [
        260,
        180
      ]
    },
    {
      "id": "eb2de889-3be6-495e-98cb-518f04a63f08",
      "name": "Save new leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/leads?on_conflict=phone",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=ignore-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.leads) }}"
      },
      "position": [
        520,
        180
      ],
      "alwaysOutputData": true
    },
    {
      "id": "6f947593-033f-47c0-99be-4cfd88673d38",
      "name": "Count imported",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "const imported = $input.all().filter(i => i.json && i.json.id).length;\nconst received = $('Clean leads').first().json.received;\nreturn [{ json: { imported, received, skipped: received - imported } }];"
      },
      "position": [
        780,
