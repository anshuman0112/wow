# Copy this file to .env and fill in your own keys. Never commit .env.
# Keep comments on their own lines (not after a value).

# ── Vapi (dashboard.vapi.ai → API Keys) ────────────────────────────────
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
# Printed by `npm run sync`
VAPI_ASSISTANT_ID=
# Vapi → Phone Numbers (after importing your Twilio number)
VAPI_PHONE_NUMBER_ID=

# ── Voice + brain (also paste the Groq + ElevenLabs keys in Vapi → Integrations)
# elevenlabs.io → Voices → pick an Indian-English voice → copy its ID
ELEVENLABS_VOICE_ID=wlmwDR77ptH6bKHZui0l
# console.groq.com → API Keys (n8n uses it for AI column mapping)
GROQ_API_KEY=

# ── Supabase (Project Settings → API) — used by n8n only ───────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── n8n ────────────────────────────────────────────────────────────────
# Your ngrok URL, e.g. https://abcd-1234.ngrok-free.app
N8N_PUBLIC_URL=
# = N8N_PUBLIC_URL + /webhook/vapi-events
N8N_VAPI_WEBHOOK_URL=
# Leads called per 5-minute dialer run
DIALER_BATCH=2

# ── Optional: hot-lead alerts on Telegram ──────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Twilio (import the number into Vapi; kept here for reference) ──────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Database password (Project Settings → Database). Lets `npm run db:schema` create the tables.
SUPABASE_DB_PASSWORD=

# Live-call brain as provider:model (default openai:gpt-4.1-mini via Vapi credits)
VAPI_LLM=openai:gpt-4.1-mini
# ElevenLabs API key (needs Text to Speech + Voices read + User read)
ELEVENLABS_API_KEY=

# Free SIP line (inbound): call Divya from a softphone app
VAPI_SIP_URI=

# ── Python API (added with the FastAPI backend) ──────────────────────────────
# Public URL of the deployed API (Twilio calls it back here)
PUBLIC_BASE_URL=https://vaani-divyasree.vercel.app
# Any long random string; Vapi sends it as X-Vapi-Secret (npm run sync sets it up)
VAPI_WEBHOOK_SECRET=
# Upstash Redis (free): live call sessions + zero-token FAQ cache. Optional.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 1 when Redis is in the same region as the API (fast); 0 to keep it off the live-call path
REDIS_ON_HOT_PATH=1
# Phone voice override (otherwise the one chosen on the Voices page / campaign default)
PHONE_VOICE=
# Browser ▶ preview of phone voices (Twilio API key + TwiML App pointing at /api/twiml/voice-preview)
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=

# PIN needed to save the Settings page (pick any 6+ digits)
ADMIN_PIN=

# Lead sources (all free). See docs/LEAD_SOURCES.md
META_VERIFY_TOKEN=          # any random text; paste the same into Meta's webhook setup
META_APP_SECRET=            # Meta app → Settings → Basic → App secret
META_PAGE_TOKEN=            # Page access token with leads_retrieval permission
GOOGLE_ADS_KEY=             # any random text; paste the same as the "Key" in the Google Ads lead form webhook

# Dashboard sign-in. Hash: python -c "from backend.auth import hash_password; print(hash_password('...'))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ── Automation (n8n + GitHub scheduler) ──
# Shared key: the scheduler and n8n send it; set the same value as the GitHub Actions secret DIALER_KEY.
DIALER_SECRET=
# n8n emails (Hot-lead alerts, 7 pm report): who receives them, and the Gmail that sends them (App password in n8n).
ALERT_EMAIL=
ALERT_FROM_EMAIL=
# Optional: a Google Sheet published as CSV; new rows become leads and get called.
LEADS_SHEET_CSV_URL=
